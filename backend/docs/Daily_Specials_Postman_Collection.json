									"var jsonData = pm.response.json();",
									"console.log('Total cars:', jsonData.total_records);",
									"",
									"// Check for Daily Specials fields",
									"jsonData.data.forEach(function(car, index) {",
									"    console.log('Car ' + car.id + ' (' + car.name + '):');",
									"    console.log('  - emirate_visibility_id:', car.emirate_visibility_id);",
									"    console.log('  - daily_specials_logo:', car.daily_specials_logo);",

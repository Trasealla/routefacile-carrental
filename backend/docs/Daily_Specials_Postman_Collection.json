		{
			"name": "5. Test Scenarios",
			"item": [
				{
					"name": "Scenario 1: Verify Abu Dhabi Filter Works",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Response is successful', function() {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Response has data array', function() {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data).to.be.an('array');",
									"});",
									"",
									"pm.test('All cars are visible in Abu Dhabi', function() {",
									"    var jsonData = pm.response.json();",
									"    jsonData.data.forEach(function(car) {",
									"        // Each car should either have emirate_visibility_id = 1 (Abu Dhabi) or null (All)",
									"        var isValid = car.emirate_visibility_id === null || ",
									"                      car.emirate_visibility_id === 1;",
									"        pm.expect(isValid, 'Car ' + car.id + ' should be visible in Abu Dhabi').to.be.true;",
									"    });",
									"});",
									"",
									"pm.test('No Dubai-only cars appear', function() {",
									"    var jsonData = pm.response.json();",
									"    var dubaiOnlyCars = jsonData.data.filter(function(car) {",
									"        return car.emirate_visibility_id === 2;",
									"    });",
									"    pm.expect(dubaiOnlyCars.length).to.equal(0);",
									"});"
								],
								"type": "text/javascript"
							}
						}

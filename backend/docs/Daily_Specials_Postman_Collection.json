				{
					"name": "Get Cars - Abu Dhabi Only (emirate_id=1)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"console.log('Total cars visible in Abu Dhabi:', jsonData.total_records);",
									"",
									"// Check which cars have Daily Specials logo",
									"var dailySpecialsCars = jsonData.data.filter(function(car) {",
									"    return car.daily_specials_logo !== null;",
									"});",
									"",
									"console.log('Cars with Daily Specials logo:', dailySpecialsCars.length);",
									"",
									"dailySpecialsCars.forEach(function(car) {",
									"    console.log('  - ' + car.name + ': ' + car.daily_specials_logo);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "x-api-key",
								"value": "{{api_key}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/car?emirate_id=1&page=1&page_size=20",
							"host": ["{{base_url}}"],
							"path": ["car"],
							"query": [
								{
									"key": "emirate_id",
									"value": "1",
									"description": "Abu Dhabi emirate ID"
								},
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "page_size",
									"value": "20"
								}
							]
						},
						"description": "**Get cars visible in Abu Dhabi**\n\n**Returns cars where:**\n- `emirate_visibility_id` = 1 (Abu Dhabi specific), OR\n- `emirate_visibility_id` IS NULL (visible in all emirates)\n\n**Daily Specials Logic:**\n- Cars with `emirate_visibility_id = 1` will have `daily_specials_logo` URL\n- Display this logo as a badge on the car card\n\n**Expected Behavior:**\n- Cars marked as \"Abu Dhabi only\" will appear with their Daily Specials logo\n- Cars marked as \"All Emirates\" will also appear (without special logo)\n- Cars marked as \"Dubai only\" will NOT appear"
					},
					"response": []
				},

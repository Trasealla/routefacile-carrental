<!DOCTYPE html>
<html lang="en" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">

<head>
    <meta charset="utf-8">
    <meta name="x-apple-disable-message-reformatting">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="format-detection" content="telephone=no, date=no, address=no, email=no">
    <title></title>
    <link
        href="https://fonts.googleapis.com/css?family=Montserrat:ital,wght@0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,200;1,300;1,400;1,500;1,600;1,700"
        rel="stylesheet" media="screen">
    <style>
        .hover-underline:hover {
            text-decoration: underline !important;
        }

        @keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        @keyframes ping {

            75%,
            100% {
                transform: scale(2);
                opacity: 0;
            }
        }

        @keyframes pulse {
            50% {
                opacity: .5;
            }
        }

        @keyframes bounce {

            0%,
            100% {
                transform: translateY(-25%);
                animation-timing-function: cubic-bezier(0.8, 0, 1, 1);
            }

            50% {
                transform: none;
                animation-timing-function: cubic-bezier(0, 0, 0.2, 1);
            }
        }

        @media (max-width: 600px) {
            .sm-leading-32 {
                line-height: 32px !important;
            }

            .sm-px-24 {
                padding-left: 24px !important;
                padding-right: 24px !important;
            }

            .sm-py-32 {
                padding-top: 32px !important;
                padding-bottom: 32px !important;
            }

            .sm-w-full {
                width: 100% !important;
            }
        }

        .promo-code-box {
            background-color: #f5f5f5;
            border: 2px dashed #c41f3e;
            padding: 20px;
            text-align: center;
            margin: 20px 0;
            border-radius: 8px;
        }

        .promo-code {
            font-size: 28px;
            font-weight: bold;
            color: #c41f3e;
            letter-spacing: 2px;
        }
    </style>
</head>

<body
    style="margin: 0; padding: 0; width: 100%; word-break: break-word; -webkit-font-smoothing: antialiased; --bg-opacity: 1; background-color: #eceff1; background-color: rgba(236, 239, 241, 1);">
    <div role="article" aria-roledescription="email" aria-label="" lang="en">
        <table style="font-family: Arial, -apple-system, 'Segoe UI', sans-serif; width: 100%;" width="100%"
            cellpadding="0" cellspacing="0" role="presentation">
            <tr>
                <td align="center"
                    style="--bg-opacity: 1; background-color: #eceff1; background-color: rgba(236, 239, 241, 1); font-family: Arial, -apple-system, 'Segoe UI', sans-serif;"
                    bgcolor="rgba(236, 239, 241, 1)">
                    <table class="sm-w-full" style="font-family: Arial,sans-serif; width: 600px;" width="600"
                        cellpadding="0" cellspacing="0" role="presentation">
                        <tr>
                            <td align="center" class="sm-px-24" style="font-family: Arial,sans-serif;"
                                bgcolor="#ffffff">
                                <table style="font-family: Arial,sans-serif; width: 100%;" width="100%" cellpadding="0"
                                    cellspacing="0" role="presentation">
                                    <tr>
                                        <td class="sm-py-32 sm-px-24"
                                            style="font-family: Arial, -apple-system, 'Segoe UI', sans-serif; padding: 48px; text-align: center;padding: 30px 48px;"
                                            align="center">
                                            <a href="#" target="_blank">
                                                <img src="{{file_server}}/mail/header.png" width="250" alt=""
                                                    style="border: 0; max-width: 100%; line-height: 100%; vertical-align: middle;">
                                            </a>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td align="center" class="sm-px-24"
                                            style="font-family: Arial,sans-serif;padding: 0px 30px;">
                                            <table style="font-family: Arial,sans-serif; width: 100%;" width="100%"
                                                cellpadding="0" cellspacing="0" role="presentation">
                                                <tr>
                                                    <td class="sm-px-24"
                                                        style="--bg-opacity: 1;padding-bottom: 23px;font-family: Arial, -apple-system, 'Segoe UI', sans-serif; font-size: 14px; line-height: 20px; text-align: left; --text-opacity: 1; color: #626262; color: rgba(98, 98, 98, 1);"
                                                        bgcolor="#ffffff" align="left">
                                                        
                                                        <p style="font-weight: 600; font-size: 18px; margin-bottom: 10px; color: #333;">
                                                            Welcome to Route Facile EDC Exclusive Program! 🎉
                                                        </p>
                                                        
                                                        <p style="margin: 15px 0;text-align: left;">
                                                            Dear <strong>{{full_name}}</strong>,
                                                        </p>

                                                        <p style="margin: 15px 0;text-align: left;">
                                                            Congratulations! Your Cities Driving Company (EDC) membership has been verified successfully. 
                                                            As a valued EDC member, you're now eligible for exclusive car rental discounts with Route Facile Car Rental - Morocco.
                                                        </p>

                                                        <p style="margin: 15px 0;text-align: left;">
                                                            <strong>Your EDC ID:</strong> {{student_id}}
                                                        </p>

                                                        <div class="promo-code-box" style="background-color: #f5f5f5; border: 2px dashed #c41f3e; padding: 20px; text-align: center; margin: 20px 0; border-radius: 8px;">
                                                            <p style="margin: 0 0 10px 0; font-size: 14px; color: #666;">Your Exclusive Promo Code:</p>
                                                            <p class="promo-code" style="font-size: 28px; font-weight: bold; color: #c41f3e; letter-spacing: 2px; margin: 0;">{{promo_code}}</p>
                                                        </div>

                                                        <p style="margin: 15px 0;text-align: left;">
                                                            <strong>How to use your promo code:</strong>
                                                        </p>
                                                        <ol style="margin: 10px 0; padding-left: 20px;">
                                                            <li style="margin-bottom: 8px;">Visit <a href="https://routefacilecarrental.com" style="color: #c41f3e;">routefacilecarrental.com</a></li>
                                                            <li style="margin-bottom: 8px;">Search for your preferred car and dates</li>
                                                            <li style="margin-bottom: 8px;">Enter the promo code <strong>{{promo_code}}</strong> in the coupon field</li>
                                                            <li style="margin-bottom: 8px;">Enjoy your exclusive EDC member discount!</li>
                                                        </ol>

                                                        <p style="margin: 15px 0;text-align: left; font-size: 12px; color: #888;">
                                                            This promo code is valid for all vehicle categories and booking types (daily, weekly, monthly).
                                                            Terms and conditions apply.
                                                        </p>

                                                        <p style="margin: 20px 0 10px 0;text-align: left;">
                                                            Thank you for choosing Route Facile Car Rental - Morocco!
                                                        </p>

                                                        <p style="margin: 10px 0;text-align: left;">
                                                            Best regards,<br>
                                                            <strong>The Route Facile Team</strong>
                                                        </p>

                                                    </td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td>
                                            <img src="{{file_server}}/mail/footer.jpg" style="max-width: 100%;">
                                        </td>
                                    </tr>
                                    <tr style="background: #e5e5e5; text-align: center;">
                                        <td style="  --text-opacity: 1; color: #eceff1; color: rgba(236, 239, 241, 1);">
                                            <a href="https://www.facebook.com/routefacilecarrental" target="_blank"
                                                style="--text-opacity: 1; color: #263238; color: rgba(38, 50, 56, 1); text-decoration: none;">Facebook</a>
                                            <a href="https://www.instagram.com/routefacilecarrental/" target="_blank"
                                                style="--text-opacity: 1; color: #263238; color: rgba(38, 50, 56, 1); text-decoration: none;">Instagram</a>
                                            <a href="https://twitter.com/routefacile" target="_blank"
                                                style="--text-opacity: 1; color: #263238; color: rgba(38, 50, 56, 1); text-decoration: none;">Twitter</a>
                                            <a href="https://www.linkedin.com/company/routefacile" target="_blank"
                                                style="--text-opacity: 1; color: #263238; color: rgba(38, 50, 56, 1); text-decoration: none;">Linkedin</a>
                                            <a href="https://www.youtube.com/@routefacile"
                                                target="_blank"
                                                style="--text-opacity: 1; color: #263238; color: rgba(38, 50, 56, 1); text-decoration: none;">Youtube</a>
                                            <p
                                                style="text-decoration: none;color:#999;margin:0;text-align: center;margin-bottom:8px;margin-top: 8px;">
                                                Copy rights
                                            </p>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    </div>
</body>

</html>



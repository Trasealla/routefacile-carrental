<!DOCTYPE html>
<html lang="en" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
  <meta charset="utf-8">
  <meta name="x-apple-disable-message-reformatting">
  <meta http-equiv="x-ua-compatible" content="ie=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="format-detection" content="telephone=no, date=no, address=no, email=no">
  <title>Newsletter Subscription</title>
  <style>
    @media (max-width: 600px) {
      .sm-w-full { width: 100% !important; }
      .sm-px-20 { padding-left: 20px !important; padding-right: 20px !important; }
      .sm-py-28 { padding-top: 28px !important; padding-bottom: 28px !important; }
      .sm-text-center { text-align: center !important; }
    }
  </style>
</head>
<body style="margin:0; padding:0; width:100%; background:#eef3f8; word-break:break-word; -webkit-font-smoothing:antialiased;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#ffffff;"><tr><td align="center" style="padding:24px 20px 8px;"><img src="{{links.file_server}}/assets/mail/header.png" width="200" alt="Route Facile" style="border:0;width:200px;max-width:70%;height:auto;display:block;margin:0 auto 18px;"></td></tr></table>

  <div role="article" aria-roledescription="email" aria-label="Newsletter Subscription" lang="en">
    <table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="width:100%; background:#eef3f8; font-family:Montserrat, Arial, sans-serif;">
      <tr>
        <td align="center" style="padding:34px 14px;">
          <table class="sm-w-full" width="600" cellpadding="0" cellspacing="0" role="presentation" style="width:600px; max-width:600px; background:#ffffff; border-radius:24px; overflow:hidden; box-shadow:0 18px 45px rgba(36,64,102,0.12);">
            <tr>
              <td style="background:#244066; padding:34px 34px 30px 34px; text-align:left;">
                <div style="display:inline-block; padding:8px 14px; background:rgba(255,255,255,0.10); border:1px solid rgba(255,255,255,0.22); border-radius:999px; color:#ffffff; font-size:12px; font-weight:700; letter-spacing:0.8px; text-transform:uppercase;">
                  Route Facile Car Rental - Morocco
                </div>
                <h1 style="margin:22px 0 8px 0; color:#ffffff; font-size:28px; line-height:36px; font-weight:800; letter-spacing:-0.4px;">
                  You are on the list
                </h1>
                <p style="margin:0; color:#dbe6f3; font-size:14px; line-height:23px;">
                  Thanks for subscribing to Route Facile newsletters. We will keep you updated with our latest offers, updates, and news.
                </p>
              </td>
            </tr>

            <tr>
              <td class="sm-px-20 sm-py-28" style="padding:34px 38px 18px 38px; color:#1f2937;">
                <p style="margin:0 0 14px 0; font-size:15px; line-height:24px; font-weight:700; color:#244066;">
                  Dear Customer,
                </p>
                <p style="margin:0 0 20px 0; font-size:14px; line-height:24px; color:#4b5563;">
                  Your email has been successfully subscribed to our newsletters.
                </p>

                <table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="width:100%; border-collapse:separate; border-spacing:0; margin:22px 0; border:1px solid #dbe4ef; border-radius:16px; overflow:hidden;">
                  <tr>
                    <td style="padding:14px 16px; background:#f7fafc; color:#244066; font-size:13px; font-weight:700; width:38%; border-bottom:1px solid #dbe4ef;">
                      Subscribed Email
                    </td>
                    <td style="padding:14px 16px; background:#ffffff; color:#111827; font-size:13px; font-weight:600; border-bottom:1px solid #dbe4ef;">
                      {{newsletter_subscription_record.email}}
                    </td>
                  </tr>
                  <tr>
                    <td style="padding:14px 16px; background:#f7fafc; color:#244066; font-size:13px; font-weight:700; width:38%;">
                      Status
                    </td>
                    <td style="padding:14px 16px; background:#ffffff; color:#16a34a; font-size:13px; font-weight:800;">
                      Subscribed Successfully
                    </td>
                  </tr>
                </table>

                <div style="background:#fff7f4; border-left:4px solid #F2421B; border-radius:14px; padding:16px 18px; margin:22px 0;">
                  <p style="margin:0; color:#244066; font-size:13px; line-height:22px; font-weight:600;">
                    You will now receive selected updates from Route Facile, including car rental offers, service announcements, and useful travel information.
                  </p>
                </div>

                <p style="margin:24px 0 0 0; color:#4b5563; font-size:14px; line-height:24px;">
                  Many Thanks,<br>
                  <strong style="color:#244066;">Route Facile Car Rental - Morocco</strong>
                </p>
              </td>
            </tr>

            <tr>
              <td style="padding:20px 34px 8px 34px;">
                <table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="border-top:1px solid #e5edf5;">
                  <tr>
                    <td align="center" style="padding:20px 0 8px 0; font-size:12px; line-height:20px; color:#6b7280;">
                      <a href="{{links.terms_and_conditions}}" style="color:#244066; text-decoration:none; font-weight:700;">Terms and Conditions</a>
                      <span style="color:#c5ced8; padding:0 8px;">|</span>
                      <a href="{{links.find_a_branch}}" style="color:#244066; text-decoration:none; font-weight:700;">Find a Branch</a>
                      <span style="color:#c5ced8; padding:0 8px;">|</span>
                      <a href="{{links.contact_us}}" style="color:#244066; text-decoration:none; font-weight:700;">Contact Us</a>
                    </td>
                  </tr>
                  <tr>
                    <td align="center" style="padding:8px 0 16px 0; font-size:12px; line-height:22px; color:#6b7280;">
                      <a href="https://www.facebook.com/routefacilecarrental" target="_blank" style="color:#244066; text-decoration:none; font-weight:600; margin:0 5px;">Facebook</a>
                      <span style="color:#d1d5db;">•</span>
                      <a href="https://www.instagram.com/routefacilecarrental/" target="_blank" style="color:#244066; text-decoration:none; font-weight:600; margin:0 5px;">Instagram</a>
                      <span style="color:#d1d5db;">•</span>
                      <a href="https://twitter.com/routefacile" target="_blank" style="color:#244066; text-decoration:none; font-weight:600; margin:0 5px;">Twitter</a>
                      <span style="color:#d1d5db;">•</span>
                      <a href="https://www.linkedin.com/company/routefacile" target="_blank" style="color:#244066; text-decoration:none; font-weight:600; margin:0 5px;">LinkedIn</a>
                      <span style="color:#d1d5db;">•</span>
                      <a href="https://www.youtube.com/@routefacile" target="_blank" style="color:#244066; text-decoration:none; font-weight:600; margin:0 5px;">YouTube</a>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
          </table>

          <table class="sm-w-full" width="600" cellpadding="0" cellspacing="0" role="presentation" style="width:600px; max-width:600px;">
            <tr>
              <td align="center" style="padding:16px 20px 0 20px; color:#8b98a8; font-size:11px; line-height:18px; font-family:Arial, sans-serif;">
                This email cannot be replied to. For support, please contact us through the official contact page.<br>
                © Route Facile Car Rental - Morocco. All rights reserved.
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </div>
</body>
</html>

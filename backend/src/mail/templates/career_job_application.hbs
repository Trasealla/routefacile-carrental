                                                    alt="Facebook"
                                                    style="border: 0; max-width: 100%; line-height: 100%; vertical-align: middle; "></a>
                                            <a href="https://www.instagram.com/routefacilecarrental/" target="_blank"
                                                style="--text-opacity: 1; color: #263238; color: rgba(38, 50, 56, 1); text-decoration: none;"><img
                                                    src="{{file_server}}/admin/social/instragram.png" width="18"
                                                    alt="Instragram"
                                                    style="border: 0; max-width: 100%; line-height: 100%; vertical-align: middle; "></a>
                                            <a href="https://twitter.com/routefacile" target="_blank"
                                                style="--text-opacity: 1; color: #263238; color: rgba(38, 50, 56, 1); text-decoration: none;"><img
                                                    src="{{file_server}}/admin/social/twitter.png" width="18"
                                                    alt="Twitter"
                                                    style="border: 0; max-width: 100%; line-height: 100%; vertical-align: middle; "></a>
                                            <a href="https://www.linkedin.com/company/routefacile" target="_blank"
                                                style="--text-opacity: 1; color: #263238; color: rgba(38, 50, 56, 1); text-decoration: none;"><img
                                                    src="{{file_server}}/admin/social/linkedin.png" width="18"
                                                    alt="Linkedin"
                                                    style="border: 0; max-width: 100%; line-height: 100%; vertical-align: middle; "></a>
                                            <a href="https://www.youtube.com/@routefacile" target="_blank"
                                                style="--text-opacity: 1; color: #263238; color: rgba(38, 50, 56, 1); text-decoration: none;"><img
                                                    src="{{file_server}}/admin/social/youtube.png" width="18"
                                                    alt="Youtube"
                                                    style="border: 0; max-width: 100%; line-height: 100%; vertical-align: middle; "></a>
                                            </p>';

                                            <p
                                                style="text-decoration: none;font-family:arial;font-size:11px;color:#999;margin:0;text-align: center;margin-bottom:8px;margin-top: 8px;">
                                                © Copyright 2026. Route Facile Car Rental - Morocco
                                            </p>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td align="center" valign="top" style="padding:10px 0">
                                            <p
                                                style="font-family:arial;font-size:11px;color:#999;padding:5px 20px;margin:0;text-align:center">
                                                This email cannot be replied. If you have any further queries and
                                                question please <a href="#" style="color:#666" rel="noreferrer"
                                                    target="_blank">Contact Us</a>
                                            </p>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    </div>
</body>

</html>
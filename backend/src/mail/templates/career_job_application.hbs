                                        </td>
                                    </tr>
                                    <tr>
                                        <td align="center" class="sm-px-24"
                                            style="font-family: Arial,sans-serif;padding: 0px 30px;">
                                            <table style="font-family: Arial,sans-serif; width: 100%;" width="100%"
                                                cellpadding="0" cellspacing="0" role="presentation">
                                                <tr>
                                                    <td class="sm-px-24"
                                                        style="--bg-opacity: 1;padding-bottom: 23px;font-family: Arial, -apple-system, 'Segoe UI', sans-serif; font-size: 14px; line-height: 15px; text-align: left; --text-opacity: 1; color: #626262; color: rgba(98, 98, 98, 1);"
                                                        bgcolor="#ffffff" align="left">
                                                        <p style="font-weight: 600; font-size: 14px; margin-bottom: 0;">
                                                            Dear Admin,
                                                        </p>
                                                        <p style="margin: 15px 0;text-align: left;">Job Application</p>

                                                        <table
                                                            style="font-family: Arial,sans-serif; width: 100%;border: 1px solid #ccc;border-color: #ccc;"
                                                            width="100%" cellpadding="0" cellspacing="0"
                                                            role="presentation">
                                                            <tr>
                                                                <td style="border-right: 1px solid #ccc;border-top: 1px solid #ccc;padding: 5px 10px;font-size: 14px;"
                                                                    width="50%">
                                                                    <strong>Job</strong>
                                                                </td>
                                                                <td style="border-right: 1px solid #ccc;border-top: 1px solid #ccc;padding: 5px 10px;font-size: 14px;"
                                                                    width="50%">
                                                                    {{application.career_job.title_en}}
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td style="border-right: 1px solid #ccc;border-top: 1px solid #ccc;padding: 5px 10px;font-size: 14px;"
                                                                    width="50%">
                                                                    <strong>Name</strong>
                                                                </td>
                                                                <td style="border-right: 1px solid #ccc;border-top: 1px solid #ccc;padding: 5px 10px;font-size: 14px;"
                                                                    width="50%">
                                                                    {{application.first_name}} {{application.last_name}}
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td style="border-right: 1px solid #ccc;border-top: 1px solid #ccc;padding: 5px 10px;font-size: 14px;"
                                                                    width="50%">
                                                                    <strong>Email</strong>
                                                                </td>
                                                                <td style="border-right: 1px solid #ccc;border-top: 1px solid #ccc;padding: 5px 10px;font-size: 14px;"
                                                                    width="50%">
                                                                    {{application.email}} 
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td style="border-right: 1px solid #ccc;border-top: 1px solid #ccc;padding: 5px 10px;font-size: 14px;"
                                                                    width="50%">
                                                                    <strong>Contact No.</strong>
                                                                </td>
                                                                <td style="border-right: 1px solid #ccc;border-top: 1px solid #ccc;padding: 5px 10px;font-size: 14px;"
                                                                    width="50%">
                                                                    {{application.phone_code }} {{application.phone_number }}
                                                                </td>
                                                            </tr>
                                                            
                                                        </table>

                                                    </td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td>
                                            <img src="{{file_server}}/mail/footer.jpg" style="max-width: 100%;">
                                        </td>
                                    </tr>

                                    <tr style="background: #e5e5e5;">
                                        <td style="padding-top: 15px;">
                                            <div
                                                style="font-weight: 600; font-size: 14px; margin-bottom: 0;text-align: center;">
                                                <a style="text-decoration: none;font-family:arial;font-size:11px;color:#999;margin:0;"
                                                    href="en/terms-and-conditions">Terms
                                                    and Conditions</a>
                                                |
                                                <a style="text-decoration: none;font-family:arial;font-size:11px;color:#999;margin:0;"
                                                    href="en/location">Find a
                                                    Branch</a>
                                            </div>
                                        </td>
                                    </tr>
                                    <tr style="background: #e5e5e5;">
                                        <td
                                            style="font-family: Arial, -apple-system, 'Segoe UI', sans-serif; font-size: 14px; --text-opacity: 1; color: #eceff1; color: rgba(236, 239, 241, 1);">
                                            <p align="center"
                                                style="cursor: default; margin-top:10px;margin-bottom:5px;">';

                                            <a href="https://www.facebook.com/routefacilecarrental" target="_blank"
                                                style="--text-opacity: 1; color: #263238; color: rgba(38, 50, 56, 1); text-decoration: none;"><img

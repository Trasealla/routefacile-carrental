<!DOCTYPE html>
<html lang="en" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">

<head>
    <meta charset="utf-8">
    <meta name="x-apple-disable-message-reformatting">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="format-detection" content="telephone=no, date=no, address=no, email=no">
    <title>Welcome to Route Facile HR Portal</title>
    <link
        href="https://fonts.googleapis.com/css?family=Montserrat:ital,wght@0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,200;1,300;1,400;1,500;1,600;1,700"
        rel="stylesheet" media="screen">
    <style>
        .hover-underline:hover {
            text-decoration: underline !important;
        }

        @media (max-width: 600px) {
            .sm-leading-32 {
                line-height: 32px !important;
            }

            .sm-px-24 {
                padding-left: 24px !important;
                padding-right: 24px !important;
            }

            .sm-py-32 {
                padding-top: 32px !important;
                padding-bottom: 32px !important;
            }

            .sm-w-full {
                width: 100% !important;
            }
        }
    </style>
</head>

<body
    style="margin: 0; padding: 0; width: 100%; word-break: break-word; -webkit-font-smoothing: antialiased; --bg-opacity: 1; background-color: #eceff1;">
    <div role="article" aria-roledescription="email" aria-label="Welcome to Route Facile HR Portal" lang="en">
        <table style="font-family: Montserrat, -apple-system, 'Segoe UI', sans-serif; width: 100%;" width="100%"
            cellpadding="0" cellspacing="0" role="presentation">
            <tr>
                <td align="center" style="background-color: #eceff1;">
                    <table class="sm-w-full" style="width: 600px;" width="600" cellpadding="0" cellspacing="0"
                        role="presentation">
                        <tr>
                            <td class="sm-py-32 sm-px-24" style="padding: 48px; text-align: center;" align="center">
                            </td>
                        </tr>
                        <tr>
                            <td align="center" class="sm-px-24">
                                <table style="width: 100%;" width="100%" cellpadding="0" cellspacing="0"
                                    role="presentation">
                                    <tr>
                                        <td class="sm-px-24"
                                            style="background-color: #ffffff; border-radius: 4px; font-size: 14px; line-height: 24px; padding: 48px; text-align: left; color: #626262;"
                                            align="left">

                                            <!-- Logo -->
                                            <div style="text-align: center; margin-bottom: 32px;">
                                                <img src="{{file_server}}/assets/logo/logo.png" alt="Route Facile Car Rental - Morocco"
                                                    style="max-width: 200px; height: auto;">
                                            </div>

                                            <!-- Success Banner -->
                                            <div
                                                style="background-color: #2e7d32; background-image: linear-gradient(135deg, #2e7d32 0%, #43a047 100%); border-radius: 8px; padding: 32px; text-align: center; margin-bottom: 32px;">
                                                <div style="margin-bottom: 12px;">
                                                    <span
                                                        style="display: inline-block; width: 56px; height: 56px; background-color: rgba(255,255,255,0.2); border-radius: 50%; line-height: 56px; font-size: 28px;">
                                                        &#10003;
                                                    </span>
                                                </div>
                                                <h1
                                                    style="color: #ffffff; font-size: 24px; font-weight: 700; margin: 0 0 8px 0;">
                                                    You're All Set!
                                                </h1>
                                                <p style="color: #ffffff; font-size: 14px; margin: 0; opacity: 0.95;">
                                                    Your password has been updated successfully
                                                </p>
                                            </div>

                                            <!-- Greeting -->
                                            <p style="margin: 0 0 24px 0; font-size: 16px; color: #333333;">
                                                Dear <strong>Mr. {{admin.first_name}} {{admin.last_name}}</strong>,
                                            </p>

                                            <p style="margin: 0 0 16px 0;">
                                                Your password has been changed successfully. Your HR Portal account is
                                                now fully activated and ready to use.
                                            </p>

                                            <!-- What You Can Do Section -->
                                            <div
                                                style="background-color: #f5f7fa; border-radius: 8px; padding: 24px; margin: 24px 0;">
                                                <h3
                                                    style="color: #1a7bb5; font-size: 16px; font-weight: 600; margin: 0 0 16px 0;">
                                                    What You Can Do
                                                </h3>
                                                <table style="width: 100%;" cellpadding="0" cellspacing="0">
                                                    <tr>
                                                        <td style="padding: 10px 0; vertical-align: top; width: 36px;">
                                                            <div
                                                                style="width: 28px; height: 28px; background-color: #e3f2fd; border-radius: 50%; text-align: center; line-height: 28px; font-size: 14px; color: #1a7bb5;">
                                                                1</div>
                                                        </td>
                                                        <td style="padding: 10px 0; vertical-align: top;">
                                                            <strong style="color: #333;">Manage Job Postings</strong>
                                                            <br>
                                                            <span style="font-size: 13px; color: #666;">Create, edit,
                                                                and publish career opportunities</span>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td
                                                            style="padding: 10px 0; vertical-align: top; width: 36px; border-top: 1px solid #e0e6ed;">
                                                            <div
                                                                style="width: 28px; height: 28px; background-color: #e3f2fd; border-radius: 50%; text-align: center; line-height: 28px; font-size: 14px; color: #1a7bb5;">
                                                                2</div>
                                                        </td>
                                                        <td
                                                            style="padding: 10px 0; vertical-align: top; border-top: 1px solid #e0e6ed;">
                                                            <strong style="color: #333;">Review Applications</strong>
                                                            <br>
                                                            <span style="font-size: 13px; color: #666;">View and manage
                                                                candidate applications</span>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td
                                                            style="padding: 10px 0; vertical-align: top; width: 36px; border-top: 1px solid #e0e6ed;">
                                                            <div
                                                                style="width: 28px; height: 28px; background-color: #e3f2fd; border-radius: 50%; text-align: center; line-height: 28px; font-size: 14px; color: #1a7bb5;">
                                                                3</div>
                                                        </td>
                                                        <td
                                                            style="padding: 10px 0; vertical-align: top; border-top: 1px solid #e0e6ed;">
                                                            <strong style="color: #333;">Track Recruitment
                                                                Pipeline</strong> <br>
                                                            <span style="font-size: 13px; color: #666;">Monitor hiring
                                                                progress and recruitment metrics</span>
                                                        </td>
                                                    </tr>
                                                </table>
                                            </div>

                                            <!-- CTA Button -->
                                            <div style="text-align: center; margin: 32px 0;">
                                                <a href="{{portal_url}}"
                                                    style="display: inline-block; background-color: #2e7d32; background-image: linear-gradient(135deg, #2e7d32 0%, #43a047 100%); color: #ffffff; font-size: 16px; font-weight: 600; text-decoration: none; padding: 14px 40px; border-radius: 6px;">
                                                    Go to HR Portal
                                                </a>
                                            </div>

                                            <!-- Security Tip -->
                                            <div
                                                style="background-color: #e8f5e9; border-left: 4px solid #43a047; border-radius: 4px; padding: 16px; margin: 24px 0;">
                                                <p
                                                    style="margin: 0; font-size: 13px; color: #2e7d32; font-weight: 600;">
                                                    &#128274; Security Tip
                                                </p>
                                                <p style="margin: 8px 0 0 0; font-size: 13px; color: #2e7d32;">
                                                    Keep your password secure and never share it with anyone. If you
                                                    suspect any unauthorized access, contact the IT department
                                                    immediately.
                                                </p>
                                            </div>

                                            <p style="margin: 24px 0 0 0;">
                                                Best Regards, <br>
                                                <strong>Route Facile Car Rental - Morocco</strong><br>
                                                <span style="font-size: 13px; color: #999999;">Human Resources
                                                    Department</span>
                                            </p>
                                        </td>
                                    </tr>

                                    <!-- Footer -->
                                    <tr style="background: #e5e5e5;">
                                        <td style="padding-top: 15px;">
                                            <div style="font-weight: 600; margin-bottom: 0; text-align: center;">
                                                <a style="text-decoration: none; color: #999; margin: 0;"
                                                    href="{{links.terms_and_conditions}}"> Terms and Conditions </a>
                                                <a style="text-decoration: none; color: #999; margin: 0;"
                                                    href="{{links.find_a_branch}}">Find a Branch</a>
                                            </div>
                                        </td>
                                    </tr>
                                    <tr style="background: #e5e5e5; text-align: center;">
                                        <td style="color: #eceff1;">
                                            <a href="https://www.facebook.com/routefacilecarrental" target="_blank"
                                                style="color: #263238; text-decoration: none;">Facebook</a>
                                            <a href="https://www.instagram.com/routefacilecarrental/" target="_blank"
                                                style="color: #263238; text-decoration: none;">Instagram</a>
                                            <a href="https://twitter.com/routefacile" target="_blank"
                                                style="color: #263238; text-decoration: none;">Twitter</a>
                                            <a href="https://www.linkedin.com/company/routefacile" target="_blank"
                                                style="color: #263238; text-decoration: none;">Linkedin</a>
                                            <a href="https://www.youtube.com/@routefacile"
                                                target="_blank"
                                                style="color: #263238; text-decoration: none;">Youtube</a>
                                            <p
                                                style="text-decoration: none; color: #999; margin: 0; text-align: center; margin-bottom: 8px; margin-top: 8px;">
                                                &copy; Route Facile Car Rental - Morocco. All rights reserved.
                                            </p>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    </div>
</body>

</html>

<!DOCTYPE html>
<html lang="en" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
  <meta charset="utf-8">
  <meta name="x-apple-disable-message-reformatting">
  <meta http-equiv="x-ua-compatible" content="ie=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="format-detection" content="telephone=no, date=no, address=no, email=no">
  <title>Password Reset OTP</title>
  <link href="https://fonts.googleapis.com/css?family=Montserrat:400,500,600,700,800&display=swap" rel="stylesheet" media="screen">
  <style>
    @media (max-width: 620px) {
      .container { width: 100% !important; }
      .px { padding-left: 22px !important; padding-right: 22px !important; }
      .hero-title { font-size: 25px !important; line-height: 33px !important; }
      .otp-box { font-size: 30px !important; letter-spacing: 7px !important; }
      .brand { font-size: 24px !important; }
    }
  </style>
</head>
<body style="margin:0; padding:0; width:100%; background:#f3f6fb; word-break:break-word; -webkit-font-smoothing:antialiased;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#ffffff;"><tr><td align="center" style="padding:24px 20px 8px;"><img src="{{links.file_server}}/assets/mail/header.png" width="200" alt="Route Facile" style="border:0;width:200px;max-width:70%;height:auto;display:block;margin:0 auto 18px;"></td></tr></table>

  <div role="article" aria-roledescription="email" aria-label="Password Reset OTP" lang="en">
    <table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="width:100%; background:#f3f6fb; font-family:Montserrat, Arial, sans-serif;">
      <tr>
        <td align="center" style="padding:34px 14px;">
          <table class="container" width="600" cellpadding="0" cellspacing="0" role="presentation" style="width:600px; max-width:600px; border-radius:28px; overflow:hidden; background:#ffffff; box-shadow:0 18px 55px rgba(36,64,102,0.14);">
            
            <!-- Header without images -->
            <tr>
              <td style="background:#244066; background-image:linear-gradient(135deg,#244066 0%,#152942 72%); padding:0;">
                <table width="100%" cellpadding="0" cellspacing="0" role="presentation">
                  <tr>
                    <td class="px" style="padding:34px 42px 12px 42px;">
                      <a href="{{links.website}}" target="_blank" style="text-decoration:none;">
                        <div class="brand" style="font-size:28px; line-height:34px; font-weight:800; letter-spacing:-0.5px; color:#ffffff;">
                          Route Facile <span style="color:#f2421b;">Car Rental</span>
                        </div>
                      </a>
                    </td>
                  </tr>
                  <tr>
                    <td class="px" style="padding:8px 42px 42px 42px;">
                      <div style="display:inline-block; background:rgba(242,66,27,0.14); color:#ffffff; border:1px solid rgba(242,66,27,0.45); border-radius:999px; padding:8px 14px; font-size:12px; font-weight:700; letter-spacing:0.3px;">
                        Secure password reset
                      </div>
                      <h1 class="hero-title" style="margin:18px 0 8px 0; color:#ffffff; font-size:32px; line-height:40px; font-weight:800; letter-spacing:-0.6px;">
                        Your verification code is ready
                      </h1>
                      <p style="margin:0; color:#dbe7f5; font-size:15px; line-height:24px; font-weight:500; max-width:460px;">
                        Use this one-time password to complete your password reset securely.
                      </p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Main Card -->
            <tr>
              <td class="px" style="padding:38px 42px 12px 42px;">
                <p style="margin:0 0 16px 0; color:#244066; font-size:16px; line-height:25px; font-weight:700;">
                  Dear {{forgot_password.user.first_name}},
                </p>
                <p style="margin:0; color:#5d6b7c; font-size:15px; line-height:25px; font-weight:500;">
                  We received a request to reset your password. Enter the OTP below to continue:
                </p>
              </td>
            </tr>

            <!-- OTP -->
            <tr>
              <td class="px" style="padding:18px 42px 10px 42px;">
                <table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="background:#f7f9fd; border:1px solid #e6edf6; border-radius:22px;">
                  <tr>
                    <td align="center" style="padding:28px 18px;">
                      <div style="font-size:12px; line-height:18px; font-weight:800; letter-spacing:1.6px; color:#f2421b; text-transform:uppercase; margin-bottom:10px;">
                        Your OTP Code
                      </div>
                      <div class="otp-box" style="font-family:Arial, sans-serif; color:#244066; font-size:38px; line-height:44px; font-weight:800; letter-spacing:10px;">
                        {{forgot_password.otp}}
                      </div>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Warning -->
            <tr>
              <td class="px" style="padding:18px 42px 34px 42px;">
                <table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="background:#fff7f4; border-left:4px solid #f2421b; border-radius:14px;">
                  <tr>
                    <td style="padding:16px 18px; color:#7a4a3c; font-size:13px; line-height:21px; font-weight:600;">
                      For your security, never share this OTP with anyone. Route Facile will never ask you for your code by phone, WhatsApp, or email.
                    </td>
                  </tr>
                </table>

                <p style="margin:24px 0 0 0; color:#5d6b7c; font-size:14px; line-height:24px; font-weight:500;">
                  Didn’t request this password reset? You can safely ignore this email.
                </p>

                <p style="margin:24px 0 0 0; color:#244066; font-size:14px; line-height:23px; font-weight:600;">
                  Many thanks,<br>
                  Route Facile Car Rental - Morocco Team
                </p>
              </td>
            </tr>

            <!-- Text Footer -->
            <tr>
              <td style="background:#f7f9fd; padding:26px 30px 8px 30px; border-top:1px solid #e6edf6;" align="center">
                <a href="{{links.terms_and_conditions}}" target="_blank" style="font-family:Arial, sans-serif; font-size:12px; line-height:18px; font-weight:700; color:#244066; text-decoration:none;">Terms and Conditions</a>
                <span style="color:#b9c4d1; padding:0 10px;">|</span>
                <a href="{{links.find_a_branch}}" target="_blank" style="font-family:Arial, sans-serif; font-size:12px; line-height:18px; font-weight:700; color:#244066; text-decoration:none;">Find a Branch</a>
              </td>
            </tr>

            <!-- Social links without icons -->
            <tr>
              <td align="center" style="background:#f7f9fd; padding:12px 30px 8px 30px;">
                <a href="https://www.facebook.com/routefacilecarrental" target="_blank" style="font-family:Arial, sans-serif; font-size:11px; line-height:18px; font-weight:700; color:#8b98a8; text-decoration:none; padding:0 5px;">Facebook</a>
                <span style="color:#c7d0db;">•</span>
                <a href="https://www.instagram.com/routefacilecarrental/" target="_blank" style="font-family:Arial, sans-serif; font-size:11px; line-height:18px; font-weight:700; color:#8b98a8; text-decoration:none; padding:0 5px;">Instagram</a>
                <span style="color:#c7d0db;">•</span>
                <a href="https://twitter.com/routefacile" target="_blank" style="font-family:Arial, sans-serif; font-size:11px; line-height:18px; font-weight:700; color:#8b98a8; text-decoration:none; padding:0 5px;">X</a>
                <span style="color:#c7d0db;">•</span>
                <a href="https://www.linkedin.com/company/routefacile" target="_blank" style="font-family:Arial, sans-serif; font-size:11px; line-height:18px; font-weight:700; color:#8b98a8; text-decoration:none; padding:0 5px;">LinkedIn</a>
                <span style="color:#c7d0db;">•</span>
                <a href="https://www.youtube.com/@routefacile" target="_blank" style="font-family:Arial, sans-serif; font-size:11px; line-height:18px; font-weight:700; color:#8b98a8; text-decoration:none; padding:0 5px;">YouTube</a>
              </td>
            </tr>

            <!-- Legal -->
            <tr>
              <td align="center" style="background:#f7f9fd; padding:10px 34px 30px 34px;">
                <p style="font-family:Arial, sans-serif; font-size:11px; line-height:18px; color:#8b98a8; margin:0 0 8px 0;">
                  © Route Facile Car Rental - Morocco. All rights reserved.
                </p>
                <p style="font-family:Arial, sans-serif; font-size:11px; line-height:18px; color:#8b98a8; margin:0;">
                  This email cannot be replied to. For further queries, please
                  <a href="{{links.contact_us}}" target="_blank" rel="noreferrer" style="color:#244066; font-weight:700; text-decoration:none;">Contact Us</a>.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </div>
</body>
</html>

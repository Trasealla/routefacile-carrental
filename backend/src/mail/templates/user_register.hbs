<!DOCTYPE html>
<html lang="en" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">

<head>
    <meta charset="utf-8">
    <meta name="x-apple-disable-message-reformatting">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="format-detection" content="telephone=no, date=no, address=no, email=no">
    <title></title>
    <link
        href="https://fonts.googleapis.com/css?family=Montserrat:ital,wght@0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,200;1,300;1,400;1,500;1,600;1,700"
        rel="stylesheet" media="screen">
    <style>
        .hover-underline:hover {
            text-decoration: underline !important;
        }

        @keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        @keyframes ping {

            75%,
            100% {
                transform: scale(2);
                opacity: 0;
            }
        }

        @keyframes pulse {
            50% {
                opacity: .5;
            }
        }

        @keyframes bounce {

            0%,
            100% {
                transform: translateY(-25%);
                animation-timing-function: cubic-bezier(0.8, 0, 1, 1);
            }

            50% {
                transform: none;
                animation-timing-function: cubic-bezier(0, 0, 0.2, 1);
            }
        }

        @media (max-width: 600px) {
            .sm-leading-32 {
                line-height: 32px !important;
            }

            .sm-px-24 {
                padding-left: 24px !important;
                padding-right: 24px !important;
            }

            .sm-py-32 {
                padding-top: 32px !important;
                padding-bottom: 32px !important;
            }

            .sm-w-full {
                width: 100% !important;
            }
        }
    </style>
</head>

<body
    style="margin: 0; padding: 0; width: 100%; word-break: break-word; -webkit-font-smoothing: antialiased; --bg-opacity: 1; background-color: #eceff1; background-color: rgba(236, 239, 241, 1);">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#ffffff;"><tr><td align="center" style="padding:24px 20px 8px;"><img src="{{links.file_server}}/assets/mail/header.png" width="200" alt="Route Facile" style="border:0;width:200px;max-width:70%;height:auto;display:block;margin:0 auto 18px;"></td></tr></table>

    <div role="article" aria-roledescription="email" aria-label="" lang="en">
        <table style="width: 100%;" width="100%"
            cellpadding="0" cellspacing="0" role="presentation">
            <tr>
                <td align="center"
                    style="--bg-opacity: 1; background-color: #eceff1; background-color: rgba(236, 239, 241, 1);"
                    bgcolor="rgba(236, 239, 241, 1)">
                    <table class="sm-w-full" style="width: 600px;"
                        width="600" cellpadding="0" cellspacing="0" role="presentation">
                        <tr>
                            <td class="sm-py-32 sm-px-24"
                                style="padding: 48px; text-align: center;"
                                align="center">
                            </td>
                        </tr>
                        <tr>
                            <td align="center" class="sm-px-24" >
                                <table style="width: 100%;" width="100%"
                                    cellpadding="0" cellspacing="0" role="presentation">
                                    <tr>
                                        <td class="sm-px-24"
                                            style="--bg-opacity: 1; background-color: #ffffff; background-color: rgba(255, 255, 255, 1); border-radius: 4px; font-size: 12px; line-height: 24px; padding: 48px; text-align: left; --text-opacity: 1; color: #626262; color: rgba(98, 98, 98, 1);"
                                            bgcolor="rgba(255, 255, 255, 1)" align="left">
                                            <p style="margin: 24px 0;">
                                                Dear {{user.first_name}} {{user.last_name}},
                                                <br>
                                                Welcome to Route Facile Car Rental - Morocco! We’re excited to have you on board.
                                                <br>
                                                {{#if classic }}
                                                    To complete your registration, use below OTP: <br>
                                                    {{register_otp}}
                                                {{else}}
                                                    Your temporary password: <strong>{{user.password_org}}</strong>.<br>
                                                    We recommend updating your password after logging in.<br>
                                                    We look forward to serving you with your booking!
                                                {{/if}}
                                            </p>
                                                Best Regards, <br>
                                                Route Facile Car Rental - Morocco 
                                            </p>
                                        </td>
                                    </tr>

                                    <tr style="background: #e5e5e5;">
                                        <td style="padding-top: 15px;">
                                            <div
                                                style="font-weight: 600; margin-bottom: 0;text-align: center;">
                                                <a style="text-decoration: none;color:#999;margin:0;"
                                                    href="{{links.terms_and_conditions}}"> Terms and Conditions </a>
                                                <a style="text-decoration: none;color:#999;margin:0;"
                                                    href="{{links.find_a_branch}}">Find a Branch</a>
                                            </div>
                                        </td>
                                    </tr>

                                    <tr style="background: #e5e5e5; text-align: center;">
                                        <td
                                            style="  --text-opacity: 1; color: #eceff1; color: rgba(236, 239, 241, 1);">
                                            <a href="https://www.facebook.com/routefacilecarrental" target="_blank"
                                                style="--text-opacity: 1; color: #263238; color: rgba(38, 50, 56, 1); text-decoration: none;">Facebook</a>
                                            <a href="https://www.instagram.com/routefacilecarrental/" target="_blank"
                                                style="--text-opacity: 1; color: #263238; color: rgba(38, 50, 56, 1); text-decoration: none;">Instagram</a>
                                            <a href="https://twitter.com/routefacile" target="_blank"
                                                style="--text-opacity: 1; color: #263238; color: rgba(38, 50, 56, 1); text-decoration: none;">Twitter</a>
                                            <a href="https://www.linkedin.com/company/routefacile" target="_blank"
                                                style="--text-opacity: 1; color: #263238; color: rgba(38, 50, 56, 1); text-decoration: none;">Linkedin</a>
                                            <a href="https://www.youtube.com/@routefacile" target="_blank"
                                                style="--text-opacity: 1; color: #263238; color: rgba(38, 50, 56, 1); text-decoration: none;">Youtube</a>
                                            <p
                                                style="text-decoration: none;color:#999;margin:0;text-align: center;margin-bottom:8px;margin-top: 8px;">
                                                Copy rights
                                            </p>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    </div>
</body>

</html>
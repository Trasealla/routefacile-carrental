<!DOCTYPE html>
<html lang="en" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">

<head>
    <meta charset="utf-8">
    <meta name="x-apple-disable-message-reformatting">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="format-detection" content="telephone=no, date=no, address=no, email=no">
    <title>Route Facile Memo Portal Sign-in PIN</title>
    <link
        href="https://fonts.googleapis.com/css?family=Montserrat:ital,wght@0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,200;1,300;1,400;1,500;1,600;1,700"
        rel="stylesheet" media="screen">
    <style>
        .hover-underline:hover {
            text-decoration: underline !important;
        }

        @media (max-width: 600px) {
            .sm-leading-32 {
                line-height: 32px !important;
            }

            .sm-px-24 {
                padding-left: 24px !important;
                padding-right: 24px !important;
            }

            .sm-py-32 {
                padding-top: 32px !important;
                padding-bottom: 32px !important;
            }

            .sm-w-full {
                width: 100% !important;
            }

            .sm-pin {
                font-size: 32px !important;
                letter-spacing: 8px !important;
            }
        }
    </style>
</head>

<body
    style="margin: 0; padding: 0; width: 100%; word-break: break-word; -webkit-font-smoothing: antialiased; --bg-opacity: 1; background-color: #eceff1;">
    <div role="article" aria-roledescription="email" aria-label="Route Facile Memo Portal Sign-in PIN" lang="en">
        <table style="font-family: Montserrat, -apple-system, 'Segoe UI', sans-serif; width: 100%;" width="100%"
            cellpadding="0" cellspacing="0" role="presentation">
            <tr>
                <td align="center" style="background-color: #eceff1;">
                    <table class="sm-w-full" style="width: 600px;" width="600" cellpadding="0" cellspacing="0"
                        role="presentation">
                        <tr>
                            <td class="sm-py-32 sm-px-24" style="padding: 48px; text-align: center;" align="center">
                            </td>
                        </tr>
                        <tr>
                            <td align="center" class="sm-px-24">
                                <table style="width: 100%;" width="100%" cellpadding="0" cellspacing="0"
                                    role="presentation">
                                    <tr>
                                        <td class="sm-px-24"
                                            style="background-color: #ffffff; border-radius: 4px; font-size: 14px; line-height: 24px; padding: 48px; text-align: left; color: #626262;"
                                            align="left">

                                            <!-- Logo -->
                                            <div style="text-align: center; margin-bottom: 32px;">
                                                <img src="{{file_server}}/assets/logo/logo.png" alt="Route Facile Car Rental - Morocco"
                                                    style="max-width: 200px; height: auto;">
                                            </div>

                                            <!-- Header Banner -->
                                            <div
                                                style="background-color: #1a7bb5; background-image: linear-gradient(135deg, #1a7bb5 0%, #2196F3 100%); border-radius: 8px; padding: 32px; text-align: center; margin-bottom: 32px;">
                                                <h1
                                                    style="color: #ffffff; font-size: 24px; font-weight: 700; margin: 0 0 8px 0;">
                                                    Memo Portal Sign-in
                                                </h1>
                                                <p style="color: #e3f2fd; font-size: 14px; margin: 0;">
                                                    Use the verification PIN below to continue
                                                </p>
                                            </div>

                                            <!-- Greeting -->
                                            <p style="margin: 0 0 16px 0; font-size: 16px; color: #333333;">
                                                Hello,
                                            </p>

                                            <p style="margin: 0 0 24px 0;">
                                                We received a sign-in request for the Route Facile Memo Portal. Please use
                                                the one-time PIN below to complete your sign-in.
                                            </p>

                                            <!-- PIN Box -->
                                            <div
                                                style="background-color: #f5f7fa; border: 1px solid #e0e6ed; border-radius: 8px; padding: 24px; margin: 24px 0; text-align: center;">
                                                <p
                                                    style="margin: 0 0 12px 0; color: #888888; font-size: 13px; text-transform: uppercase; letter-spacing: 1px;">
                                                    Your Sign-in PIN
                                                </p>
                                                <p class="sm-pin"
                                                    style="margin: 0; font-family: 'Courier New', Courier, monospace; font-size: 36px; font-weight: 700; letter-spacing: 12px; color: #1a7bb5;">
                                                    <span style="user-select: all; -webkit-user-select: all;">{{pin}}</span>
                                                </p>
                                                <p style="margin: 16px 0 0 0; color: #888888; font-size: 13px;">
                                                    Expires in <strong style="color: #333333;">{{expires_in_minutes}} minutes</strong>
                                                </p>
                                            </div>

                                            <!-- Security Notice -->
                                            <div
                                                style="background-color: #fff8e1; border-left: 4px solid #ffc107; border-radius: 4px; padding: 16px; margin: 24px 0;">
                                                <p
                                                    style="margin: 0; font-size: 13px; color: #795548; font-weight: 600;">
                                                    &#9888; Security Notice
                                                </p>
                                                <p style="margin: 8px 0 0 0; font-size: 13px; color: #795548;">
                                                    Never share this PIN with anyone. Route Facile staff, IT, or support
                                                    will never ask you for it. If you did not request this PIN, you can
                                                    safely ignore this email.
                                                </p>
                                            </div>

                                            <p style="margin: 0 0 8px 0; font-size: 13px; color: #999999;">
                                                If you have any questions or need assistance, please contact the IT
                                                department.
                                            </p>

                                            <p style="margin: 24px 0 0 0;">
                                                Best Regards, <br>
                                                <strong>Route Facile Car Rental - Morocco</strong><br>
                                                <span style="font-size: 13px; color: #999999;">Information Technology
                                                    Department</span>
                                            </p>
                                        </td>
                                    </tr>

                                    <!-- Footer -->
                                    <tr style="background: #e5e5e5;">
                                        <td style="padding-top: 15px;">
                                            <div style="font-weight: 600; margin-bottom: 0; text-align: center;">
                                                <a style="text-decoration: none; color: #999; margin: 0;"
                                                    href="https://routefacilecarrental.com/en/termscondition"> Terms and Conditions </a>
                                                <a style="text-decoration: none; color: #999; margin: 0 0 0 12px;"
                                                    href="https://routefacilecarrental.com/en/location">Find a Branch</a>
                                            </div>
                                        </td>
                                    </tr>
                                    <tr style="background: #e5e5e5; text-align: center;">
                                        <td style="color: #eceff1;">
                                            <a href="https://www.facebook.com/routefacilecarrental" target="_blank"
                                                style="color: #263238; text-decoration: none; margin: 0 6px;">Facebook</a>
                                            <a href="https://www.instagram.com/routefacilecarrental/" target="_blank"
                                                style="color: #263238; text-decoration: none; margin: 0 6px;">Instagram</a>
                                            <a href="https://twitter.com/routefacile" target="_blank"
                                                style="color: #263238; text-decoration: none; margin: 0 6px;">Twitter</a>
                                            <a href="https://www.linkedin.com/company/routefacile" target="_blank"
                                                style="color: #263238; text-decoration: none; margin: 0 6px;">Linkedin</a>
                                            <a href="https://www.youtube.com/@routefacile"
                                                target="_blank"
                                                style="color: #263238; text-decoration: none; margin: 0 6px;">Youtube</a>
                                            <p
                                                style="text-decoration: none; color: #999; margin: 0; text-align: center; margin-bottom: 8px; margin-top: 8px;">
                                                &copy; Route Facile Car Rental - Morocco. All rights reserved.
                                            </p>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    </div>
</body>

</html>

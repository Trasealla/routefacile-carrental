<!DOCTYPE html>
<html lang="en" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">

<head>
    <meta charset="utf-8">
    <meta name="x-apple-disable-message-reformatting">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="format-detection" content="telephone=no, date=no, address=no, email=no">
    <title>Booking Confirmed | Route Facile</title>
    <link
        href="https://fonts.googleapis.com/css?family=Montserrat:ital,wght@0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,200;1,300;1,400;1,500;1,600;1,700"
        rel="stylesheet" media="screen">
    <style>
        .hover-underline:hover {
            text-decoration: underline !important;
        }

        @keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        @keyframes ping {

            75%,
            100% {
                transform: scale(2);
                opacity: 0;
            }
        }

        @keyframes pulse {
            50% {
                opacity: .5;
            }
        }

        @keyframes bounce {

            0%,
            100% {
                transform: translateY(-25%);
                animation-timing-function: cubic-bezier(0.8, 0, 1, 1);
            }

            50% {
                transform: none;
                animation-timing-function: cubic-bezier(0, 0, 0.2, 1);
            }
        }


        body, table, td, p, a, li {
            font-family: Montserrat, Arial, sans-serif !important;
        }
        p {
            color: #243044;
            font-size: 14px;
            line-height: 1.75;
        }
        li {
            color: #243044;
            font-size: 13px;
            line-height: 1.65;
            margin-bottom: 6px;
        }
        a {
            color: #F2421B;
            font-weight: 600;
        }
        .email-card {
            border-radius: 24px;
            overflow: hidden;
            box-shadow: 0 18px 45px rgba(36,64,102,0.12);
        }
        .brand-top {
            background: linear-gradient(135deg, #244066 0%, #18304f 58%, #F2421B 140%);
            color: #ffffff;
        }
        .brand-pill {
            display: inline-block;
            padding: 8px 14px;
            border-radius: 999px;
            background: rgba(255,255,255,0.12);
            border: 1px solid rgba(255,255,255,0.25);
            color: #ffffff;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .6px;
            text-transform: uppercase;
        }
        .section-title {
            color: #244066;
            font-size: 18px;
            line-height: 1.35;
            font-weight: 800;
            margin: 28px 0 12px;
        }
        .info-box {
            background: #fff7f4;
            border: 1px solid #ffd8cc;
            border-radius: 16px;
            padding: 16px 18px;
            margin: 20px 0;
        }
        .summary-card {
            background: #f7f9fc;
            border: 1px solid #e6ebf2;
            border-radius: 18px;
            padding: 18px;
            margin: 20px 0;
        }
        .footer-link {
            display: inline-block;
            padding: 6px 8px;
            color: #244066 !important;
            font-size: 12px;
            font-weight: 700;
        }
        @media (max-width: 600px) {
            .email-card { border-radius: 0 !important; }
            .mobile-center { text-align: center !important; }
        }

        @media (max-width: 600px) {
            .sm-leading-32 {
                line-height: 32px !important;
            }

            .sm-px-24 {
                padding-left: 24px !important;
                padding-right: 24px !important;
            }

            .sm-py-32 {
                padding-top: 32px !important;
                padding-bottom: 32px !important;
            }

            .sm-w-full {
                width: 100% !important;
            }
        }
    </style>
</head>

<body style="margin: 0; padding: 0; width: 100%; word-break: break-word; font-size: 14px; line-height: 1.6; -webkit-font-smoothing: antialiased; background-color: #f3f6fb;">
    <div role="article" aria-roledescription="email" aria-label="" lang="en">
        <table style="font-family: Montserrat, -apple-system, 'Segoe UI', sans-serif; width: 100%;" width="100%"
            cellpadding="0" cellspacing="0" role="presentation">
            <tr>
                <td align="center"
                    style="--bg-opacity: 1; background-color: #f3f6fb; font-family: Montserrat, -apple-system, 'Segoe UI', sans-serif;"
                    bgcolor="#f3f6fb">
                    <table class="sm-w-full" style="font-family: 'Montserrat',Arial,sans-serif; width: 600px;"
                        width="600" cellpadding="0" cellspacing="0" role="presentation">
                        <tr>
                            <td class="sm-py-32 sm-px-24 brand-top" style="padding: 36px 42px; text-align: left; background: linear-gradient(135deg, #244066 0%, #18304f 58%, #F2421B 140%);" align="left">
                                <img src="{{links.file_server}}/assets/mail/logo-white.png" width="180" alt="Route Facile"
                                     style="border:0;width:180px;max-width:60%;height:auto;display:block;margin-bottom:20px;">
                                <div style="display:inline-block;padding:8px 14px;border-radius:999px;background:rgba(255,255,255,0.12);border:1px solid rgba(255,255,255,0.25);color:#ffffff;font-size:11px;font-weight:700;letter-spacing:.6px;text-transform:uppercase;">R&eacute;servation confirm&eacute;e &middot; Booking confirmed</div>
                                <h1 style="margin:18px 0 8px;color:#ffffff;font-size:26px;line-height:1.25;font-weight:800;">Votre location Route Facile est confirm&eacute;e</h1>
                                <p style="margin:0 0 10px;color:#dbe7f7;font-size:16px;line-height:1.4;font-weight:600;">Your Route Facile car rental is ready</p>
                                <p style="margin:0;color:#dbe7f7;font-size:14px;line-height:1.7;">R&eacute;servation n&deg; / Booking No. <strong style="color:#ffffff;">{{booking.booking_number}}</strong></p>
                            </td>
                        </tr>
                        <tr>
                            <td align="center" class="sm-px-24" style="font-family: 'Montserrat',Arial,sans-serif;">
                                <table style="font-family: 'Montserrat',Arial,sans-serif; width: 100%;" width="100%"
                                    cellpadding="0" cellspacing="0" role="presentation">
                                    <tr>
                                        <td align="center" class="sm-px-24"
                                            style="font-family: Arial,sans-serif;padding: 0px 30px;padding-bottom:15px;">
                                            <table style="font-family: Arial,sans-serif; width: 100%;" width="100%"
                                                cellpadding="0" cellspacing="0" role="presentation">
                                                <tr>
                                                    <td style="">
                                                        <p style="font-weight: 600; font-size: 14px; margin-bottom: 0;">
                                                            Bonjour {{booking.user_first_name}},
                                                        </p>
                                                        <p style="margin: 12px 0;text-align: left;">
                                                            Merci d'avoir r&eacute;serv&eacute; avec Route Facile. Votre r&eacute;servation est
                                                            confirm&eacute;e et les d&eacute;tails figurent ci-dessous. Le paiement s'effectue
                                                            au moment de la prise en charge du v&eacute;hicule.
                                                        </p>
                                                        <p style="margin: 12px 0 18px;text-align: left;color:#4a5568;font-size:13px;border-left:3px solid #e6e9ee;padding-left:12px;">
                                                            Thank you for booking with Route Facile. Your reservation is
                                                            confirmed and the details are below. Payment is made when you
                                                            collect the car.
                                                        </p>
                                                        <table role="presentation" cellpadding="0" cellspacing="0" width="100%"
                                                               style="font-family:Arial,sans-serif;font-size:14px;border-collapse:collapse;margin:18px 0;">
                                                            <tr><td colspan="2" style="padding:10px 0 6px;font-weight:700;color:#0D1B2A;border-bottom:2px solid #E02F12;">
                                                                R&eacute;servation &middot; Booking details
                                                            </td></tr>
                                                            <tr>
                                                                <td style="padding:9px 0;color:#4a5568;width:42%;">R&eacute;serv&eacute; avec<br><span style="font-weight:400;font-size:12px;color:#8a94a3;">Booked with</span></td>
                                                                <td style="padding:9px 0;font-weight:600;color:#0D1B2A;">
                                                                    <bdi dir="ltr">{{customer_contact}}</bdi>
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td style="padding:9px 0;color:#4a5568;">V&eacute;hicule<br><span style="font-weight:400;font-size:12px;color:#8a94a3;">Vehicle</span></td>
                                                                <td style="padding:9px 0;font-weight:600;color:#0D1B2A;">{{booking.car.name_en}}</td>
                                                            </tr>
                                                            <tr>
                                                                <td style="padding:9px 0;color:#4a5568;">Prise en charge<br><span style="font-weight:400;font-size:12px;color:#8a94a3;">Pick-up</span></td>
                                                                <td style="padding:9px 0;font-weight:600;color:#0D1B2A;">
                                                                    {{formatDate booking.pickup_date_time}}<br>
                                                                    <span style="font-weight:400;color:#4a5568;">{{booking.pickup_location.name_en}}, {{booking.pickup_city.name_en}}</span>
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td style="padding:9px 0;color:#4a5568;">Restitution<br><span style="font-weight:400;font-size:12px;color:#8a94a3;">Drop-off</span></td>
                                                                <td style="padding:9px 0;font-weight:600;color:#0D1B2A;">
                                                                    {{formatDate booking.dropoff_date_time}}<br>
                                                                    <span style="font-weight:400;color:#4a5568;">{{booking.dropoff_location.name_en}}, {{booking.dropoff_city.name_en}}</span>
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td style="padding:9px 0;color:#4a5568;">Dur&eacute;e<br><span style="font-weight:400;font-size:12px;color:#8a94a3;">Duration</span></td>
                                                                <td style="padding:9px 0;font-weight:600;color:#0D1B2A;">{{booking.booking_days}} jour(s) / day(s)</td>
                                                            </tr>
                                                            <tr>
                                                                <td style="padding:9px 0;color:#4a5568;border-top:1px solid #e6e9ee;">Total</td>
                                                                <td style="padding:9px 0;font-weight:700;color:#E02F12;border-top:1px solid #e6e9ee;">MAD {{booking.total_amount}}</td>
                                                            </tr>
                                                            <tr>
                                                                <td style="padding:9px 0;color:#4a5568;">Paiement<br><span style="font-weight:400;font-size:12px;color:#8a94a3;">Payment</span></td>
                                                                <td style="padding:9px 0;font-weight:600;color:#0D1B2A;">Payable &agrave; la prise en charge<br><span style="font-weight:400;font-size:12px;color:#8a94a3;">Payable on collection</span></td>
                                                            </tr>
                                                        </table>

                                                        <p style=" font-size: 14px; margin-bottom: 0;">
                                                            Merci et &agrave; bient&ocirc;t,<br>
                                                            Many thanks &mdash; with best regards,<br>
                                                            <strong>Route Facile Car Rental</strong>
                                                        </p>
                                                    </td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td>
                                            
                                        </td>
                                    </tr>

                                    <tr style="background: #f7f9fc;">
                                        <td style="padding-top: 15px;">
                                            <div
                                                style="font-weight: 600; font-size: 14px; margin-bottom: 0;text-align: center;">
                                                <a style="text-decoration: none;font-family:arial;font-size:11px;color:#6b7280;margin:0;"
                                                    href="{{links.terms_and_conditions}}">Conditions g&eacute;n&eacute;rales / Terms</a>
                                                |
                                                <a style="text-decoration: none;font-family:arial;font-size:11px;color:#6b7280;margin:0;"
                                                    href="{{links.find_a_branch}}">Nos agences / Find a Branch</a>
                                            </div>
                                        </td>
                                    </tr>

                                    <tr style="background: #f7f9fc; text-align: center;">
                                        <td
                                            style="font-family: Arial, -apple-system, 'Segoe UI', sans-serif; font-size: 14px; --text-opacity: 1; color: #eceff1; color: rgba(236, 239, 241, 1);">
                                            <a class="footer-link" href="https://api.whatsapp.com/send/?phone=212655585859" target="_blank" style="display:inline-block;padding:6px 8px;color:#244066;text-decoration:none;font-size:12px;font-weight:700;">WhatsApp</a>
                                            <a class="footer-link" href="tel:+212655585859" style="display:inline-block;padding:6px 8px;color:#244066;text-decoration:none;font-size:12px;font-weight:700;">+212 655 585 859</a>
                                            <a class="footer-link" href="https://routefacilecarrental.com" target="_blank" style="display:inline-block;padding:6px 8px;color:#244066;text-decoration:none;font-size:12px;font-weight:700;">routefacilecarrental.com</a>
                                            <p style="text-decoration: none;font-family:arial;font-size:11px;color:#6b7280;margin:0;text-align: center;margin-bottom:8px;margin-top: 8px;">
                                                © Route Facile. All rights reserved.
                                            </p>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td align="center" valign="top" style="padding:10px 0">
                                            <p
                                                style="font-family:arial;font-size:11px;color:#6b7280;padding:5px 20px;margin:0;text-align:center">
                                                Cet e-mail ne peut pas recevoir de r&eacute;ponse. This email cannot be replied to. <a href="{{links.contact_us}}" style="color:#666" rel="noreferrer"
                                                    target="_blank">Contact Us</a></p>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    </div>
</body>

</html>